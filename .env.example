# Copy this file to .env and fill in real values.
# DO NOT commit .env — it is gitignored.

# Anthropic API key for AI summary generation.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Postgres connection URL used by the backend (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://roger:roger@db:5432/roger

# Frontend → backend base URL (used by Vite at build/dev time).
VITE_API_BASE_URL=http://localhost:8000
